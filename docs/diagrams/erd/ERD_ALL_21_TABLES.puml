@startuml
title Tech Store - ERD All Tables (derived from 21-table SQL DRAFT)
skinparam monochrome true
skinparam shadowing false
skinparam linetype ortho
hide circle
left to right direction

entity "roles" as roles {
  * id : BIGINT <<PK>>
    name : VARCHAR(30)  (required)
}

entity "users" as users {
  * id : BIGINT <<PK>>
    email : VARCHAR(100)  (required)
    phone : VARCHAR(20)  (required)
    password : VARCHAR(255)  (required)
    full_name : VARCHAR(100)  (required)
    avatar_url : VARCHAR(1024)
    avatar_public_id : VARCHAR(255)
    status : VARCHAR(20)  (required)
    created_at : DATETIME  (required)
    updated_at : DATETIME  (required)
}

entity "user_roles" as user_roles {
  * user_id : BIGINT <<PK,FK>>
  * role_id : BIGINT <<PK,FK>>
}

entity "addresses" as addresses {
  * id : BIGINT <<PK>>
    user_id : BIGINT <<FK>> (required)
    recipient_name : VARCHAR(100)  (required)
    phone : VARCHAR(20)  (required)
    street_address : VARCHAR(255)  (required)
    ward : VARCHAR(100)
    district : VARCHAR(100)
    city : VARCHAR(100)  (required)
    is_default : BOOLEAN  (required)
    created_at : DATETIME  (required)
    updated_at : DATETIME  (required)
}

entity "password_reset_tokens" as password_reset_tokens {
  * id : BIGINT <<PK>>
    user_id : BIGINT <<FK>> (required)
    otp_hash : VARCHAR(255)  (required)
    expiry_date : DATETIME  (required)
    is_used : BOOLEAN  (required)
    failed_attempts : INT  (required)
    created_at : DATETIME  (required)
}

entity "email_verifications" as email_verifications {
  * id : BIGINT <<PK>>
    email : VARCHAR(100)  (required)
    otp_hash : VARCHAR(255)  (required)
    expiry_date : DATETIME  (required)
    is_used : BOOLEAN  (required)
    failed_attempts : INT  (required)
    created_at : DATETIME  (required)
}

entity "categories" as categories {
  * id : BIGINT <<PK>>
    name : VARCHAR(100)  (required)
    slug : VARCHAR(100)  (required)
    description : TEXT
    image_url : VARCHAR(1024)
    image_public_id : VARCHAR(255)
    status : VARCHAR(20)  (required)
    created_at : DATETIME  (required)
    updated_at : DATETIME  (required)
}

entity "brands" as brands {
  * id : BIGINT <<PK>>
    name : VARCHAR(100)  (required)
    slug : VARCHAR(100)  (required)
    country : VARCHAR(100)
    logo_url : VARCHAR(1024)
    logo_public_id : VARCHAR(255)
    description : TEXT
    status : VARCHAR(20)  (required)
    created_at : DATETIME  (required)
    updated_at : DATETIME  (required)
}

entity "branches" as branches {
  * id : BIGINT <<PK>>
    name : VARCHAR(150)  (required)
    phone : VARCHAR(20)
    address : VARCHAR(255)  (required)
    status : VARCHAR(20)  (required)
    created_at : DATETIME  (required)
    updated_at : DATETIME  (required)
}

entity "products" as products {
  * id : BIGINT <<PK>>
    category_id : BIGINT <<FK>> (required)
    brand_id : BIGINT <<FK>> (required)
    name : VARCHAR(200)  (required)
    slug : VARCHAR(255)  (required)
    sku : VARCHAR(50)  (required)
    price : DECIMAL(15,2)  (required)
    cost_price : DECIMAL(15,2)  (required)
    description : LONGTEXT
    specifications : TEXT
    status : VARCHAR(20)  (required)
    created_at : DATETIME  (required)
    updated_at : DATETIME  (required)
}

entity "product_images" as product_images {
  * id : BIGINT <<PK>>
    product_id : BIGINT <<FK>> (required)
    image_url : VARCHAR(1024)  (required)
    cloudinary_public_id : VARCHAR(255)  (required)
    is_primary : BOOLEAN  (required)
    display_order : INT  (required)
}

entity "inventories" as inventories {
  * id : BIGINT <<PK>>
    product_id : BIGINT <<FK>> (required)
    branch_id : BIGINT <<FK>> (required)
    quantity : INT  (required)
    min_stock_alert : INT  (required)
    updated_at : DATETIME  (required)
}

entity "carts" as carts {
  * id : BIGINT <<PK>>
    user_id : BIGINT <<FK>> (required)
    created_at : DATETIME  (required)
    updated_at : DATETIME  (required)
}

entity "cart_items" as cart_items {
  * id : BIGINT <<PK>>
    cart_id : BIGINT <<FK>> (required)
    product_id : BIGINT <<FK>> (required)
    quantity : INT  (required)
    created_at : DATETIME  (required)
    updated_at : DATETIME  (required)
}

entity "coupons" as coupons {
  * id : BIGINT <<PK>>
    code : VARCHAR(50)  (required)
    discount_type : VARCHAR(20)  (required)
    discount_value : DECIMAL(15,2)  (required)
    min_order_amount : DECIMAL(15,2)  (required)
    max_discount_amount : DECIMAL(15,2)
    usage_limit : INT  (required)
    used_count : INT  (required)
    start_date : DATETIME  (required)
    end_date : DATETIME  (required)
    is_active : BOOLEAN  (required)
    created_at : DATETIME  (required)
    updated_at : DATETIME  (required)
}

entity "orders" as orders {
  * id : BIGINT <<PK>>
    order_code : VARCHAR(50)  (required)
    user_id : BIGINT <<FK>> (required)
    branch_id : BIGINT <<FK>> (required)
    recipient_name : VARCHAR(100)  (required)
    recipient_phone : VARCHAR(20)  (required)
    shipping_address : VARCHAR(255)  (required)
    total_items_amount : DECIMAL(15,2)  (required)
    discount_amount : DECIMAL(15,2)  (required)
    final_amount : DECIMAL(15,2)  (required)
    status : VARCHAR(30)  (required)
    payment_method : VARCHAR(20)  (required)
    payment_status : VARCHAR(20)  (required)
    coupon_id : BIGINT <<FK>>
    notes : TEXT
    cancel_reason : TEXT
    cancelled_at : DATETIME
    created_at : DATETIME  (required)
    updated_at : DATETIME  (required)
}

entity "order_items" as order_items {
  * id : BIGINT <<PK>>
    order_id : BIGINT <<FK>> (required)
    product_id : BIGINT <<FK>> (required)
    product_name : VARCHAR(200)  (required)
    product_sku : VARCHAR(50)  (required)
    product_image : VARCHAR(1024)
    unit_price : DECIMAL(15,2)  (required)
    quantity : INT  (required)
    subtotal_amount : DECIMAL(15,2)  (required)
}

entity "payments" as payments {
  * id : BIGINT <<PK>>
    order_id : BIGINT <<FK>> (required)
    payment_method : VARCHAR(20)  (required)
    transaction_code : VARCHAR(100)
    amount : DECIMAL(15,2)  (required)
    status : VARCHAR(20)  (required)
    paid_at : DATETIME
    refunded_at : DATETIME
    created_at : DATETIME  (required)
}

entity "coupon_usages" as coupon_usages {
  * id : BIGINT <<PK>>
    coupon_id : BIGINT <<FK>> (required)
    user_id : BIGINT <<FK>> (required)
    order_id : BIGINT <<FK>> (required)
    status : VARCHAR(20)  (required)
    used_at : DATETIME  (required)
    reversed_at : DATETIME
}

entity "reviews" as reviews {
  * id : BIGINT <<PK>>
    user_id : BIGINT <<FK>> (required)
    product_id : BIGINT <<FK>> (required)
    order_id : BIGINT <<FK>> (required)
    rating : INT  (required)
    comment : TEXT  (required)
    status : VARCHAR(30)  (required)
    hidden_at : DATETIME
    hidden_reason : VARCHAR(255)
    created_at : DATETIME  (required)
    updated_at : DATETIME  (required)
}

entity "audit_logs" as audit_logs {
  * id : BIGINT <<PK>>
    user_id : BIGINT
    action : VARCHAR(100)  (required)
    entity_name : VARCHAR(50)  (required)
    entity_id : BIGINT
    details : TEXT
    ip_address : VARCHAR(50)
    created_at : DATETIME  (required)
}

users ||--o{ user_roles : "user_id"
roles ||--o{ user_roles : "role_id"
users ||--o{ addresses : "user_id"
users ||--o{ password_reset_tokens : "user_id"
categories ||--o{ products : "category_id"
brands ||--o{ products : "brand_id"
products ||--o{ product_images : "product_id"
products ||--o{ inventories : "product_id"
branches ||--o{ inventories : "branch_id"
users ||--o{ carts : "user_id"
carts ||--o{ cart_items : "cart_id"
products ||--o{ cart_items : "product_id"
users ||--o{ orders : "user_id"
branches ||--o{ orders : "branch_id"
coupons |o--o{ orders : "coupon_id"
orders ||--o{ order_items : "order_id"
products ||--o{ order_items : "product_id"
orders ||--o{ payments : "order_id"
coupons ||--o{ coupon_usages : "coupon_id"
users ||--o{ coupon_usages : "user_id"
orders ||--o{ coupon_usages : "order_id"
users ||--o{ reviews : "user_id"
products ||--o{ reviews : "product_id"
orders ||--o{ reviews : "order_id"
@enduml

@startuml
autonumber
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
title sd Quản lý người dùng và vai trò
actor "Admin" as U
boundary "Màn hình người dùng" as UI
control "AdminUserController" as C
control "UserService" as S
database "User" as Users
database "UserRole / Role" as Roles
U -> UI: Khóa / mở khóa / phân vai trò
UI -> C: updateUser(userId, changes)
C -> S: updateUser(actor, target, changes)
S -> Users: findById(userId)
S -> S: checkAdminAndSelfProtection()
alt Thay đổi hợp lệ
    opt Thay trạng thái
        S -> Users: updateStatus(ACTIVE / LOCKED)
    end
    opt Phân vai trò
        S -> Roles: saveUserRoles(roleIds)
    end
    S --> UI: 200 OK
    UI --> U: Cập nhật thành công
else Không hợp lệ
    S --> UI: 403 / 404 / 409
    UI --> U: Hiển thị lỗi
end
@enduml

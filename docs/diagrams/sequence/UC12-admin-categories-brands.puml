@startuml
autonumber
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
title sd Quản lý danh mục và thương hiệu
actor "Admin" as U
boundary "Màn hình danh mục / hãng" as UI
control "CatalogController" as C
control "CatalogService" as S
participant "Cloudinary" as Cloud
database "Category" as Categories
database "Brand" as Brands
U -> UI: Thêm / sửa / vô hiệu hóa
UI -> C: saveCatalog(type, data, image)
C -> S: saveCatalog(request)
S -> S: Kiểm tra ROLE_ADMIN, slug, dữ liệu
alt Hợp lệ
    opt Có ảnh mới
        S -> Cloud: uploadImage(file)
        Cloud --> S: secure_url, public_id
    end
    alt type = CATEGORY
        S -> Categories: saveCategory()
    else type = BRAND
        S -> Brands: saveBrand()
    end
    S --> UI: 200 / 201 OK
    UI --> U: Cập nhật danh sách
else Không hợp lệ
    S --> UI: 400 / 403 / 409
    UI --> U: Hiển thị lỗi
end
@enduml

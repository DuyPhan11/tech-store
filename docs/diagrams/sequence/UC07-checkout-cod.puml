@startuml
autonumber
skinparam monochrome true
skinparam shadowing false
skinparam sequenceMessageAlign center
title sd Đặt hàng COD
actor "Khách hàng" as U
boundary "Màn hình checkout" as UI
control "CheckoutController" as C
control "CheckoutService" as S
database "Cart / Product" as Cart
database "Branch / Inventory" as Stock
database "Order / Payment / Coupon" as DB
U -> UI: Xác nhận đặt hàng COD
UI -> C: checkout(request)
C -> S: checkout(user, request)
S -> Cart: resolveItems(CART / BUY_NOW)
S -> Stock: checkActiveBranchAndLockStock()
S -> S: Tính tiền, kiểm tra coupon
alt Dữ liệu và tồn kho hợp lệ
    group Transaction
        S -> DB: createOrder(PENDING)
        S -> DB: createPayment(COD, UNPAID)
        S -> Stock: decreaseStock()
        opt Có coupon
            S -> DB: saveUsage(ACTIVE)
        end
        opt source = CART
            S -> Cart: removeSelectedItems()
        end
    end
    S --> UI: 201 Created
    UI --> U: Đặt hàng thành công
else Không hợp lệ
    S --> UI: 400 / 409
    UI --> U: Không tạo đơn, giữ giỏ
end
@enduml

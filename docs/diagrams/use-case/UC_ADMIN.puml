@startuml
title Tech Store - Quản trị
left to right direction
skinparam monochrome true
skinparam shadowing false
actor "Nhân viên" as Staff
actor "Quản trị viên" as Admin
Staff <|-- Admin
rectangle "Tech Store" {
  usecase "UC11\nQuản lý sản phẩm" as UC11
  usecase "UC12\nDanh mục và thương hiệu" as UC12
  usecase "UC13\nQuản lý coupon" as UC13
  usecase "UC14\nQuản lý đơn hàng" as UC14
  usecase "UC15\nQuản lý người dùng" as UC15
  usecase "UC16\nQuản lý nhân viên" as UC16
  usecase "UC17\nThống kê doanh thu" as UC17
  usecase "UC18\nQuản lý tồn kho" as UC18
  usecase "UC19\nQuản lý chi nhánh" as UC19
  usecase "UC20\nKiểm duyệt đánh giá" as UC20
}
Staff --> UC11
Staff --> UC13
Staff --> UC14
Staff --> UC17
Staff --> UC18
Admin --> UC12
Admin --> UC15
Admin --> UC16
Admin --> UC19
Admin --> UC20
@enduml
